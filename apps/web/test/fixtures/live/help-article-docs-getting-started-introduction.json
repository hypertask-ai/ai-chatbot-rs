  "source": "https://help.hypertask.ai/help/docs-getting-started-introduction",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content\">\n  <title>What is Hypertask? - Help Center - Hypertask</title>\n  <meta name=\"description\" content=\"AI-native project management for teams and AI agents — manage tasks, collaborate in real-time, and connect AI agents with MCP, CLI, and REST APIs.\">\n  <link rel=\"icon\" type=\"image/png\" href=\"https://hypertask.ai/glyph-white.png\">\n  <script src=\"https://cdn.usefathom.com/script.js\" data-site=\"SSBYTYUQ\" defer></script>\n  \n  \n  <style type=\"text/css\">@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/latin/700/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/cyrillic-ext/700/normal.woff2);unicode-range:U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/vietnamese/700/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/cyrillic/700/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/latin-ext/700/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/vietnamese/wght/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}</style>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    :root {\n      /* Source: https://hypertask.ai homepage CSS (.h1x, .h1-btn-primary), fetched 2026-10-25. */\n      --ht-p1: #000000;\n      --ht-p2: #0b0b0d;\n      --ht-ink: #f4f4f7;\n      --ht-ink-2: rgba(244, 244, 247, 0.64);\n      --ht-ink-3: rgba(244, 244, 247, 0.40);\n      --ht-line: rgba(244, 244, 247, 0.10);\n      --ht-line-2: rgba(244, 244, 247, 0.16);\n      --ht-btn-bg: #ffffff;\n      --ht-btn-fg: #000000;\n      --ht-btn-hover: #d9d9d9;\n      --ht-radius-btn: 8px;\n      --ht-radius-lg: 14px;\n      --ht-font-display: \"Newsreader\", Georgia, serif;\n      --ht-font-body: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n      --ht-font-wordmark: \"IBM Plex Mono\", ui-monospace, monospace;\n\n      --ht-secondary: #262626;\n      --page-bg: #000000;\n      --surface: #0b0b0d;\n      --surface-hover: #191a1e;\n      --ink: var(--ht-ink);\n      --muted: #a7a8ad;\n      --surface-border: rgba(255, 255, 255, 0.14);\n      --divider: rgba(255, 255, 255, 0.10);\n      --chat-bg: var(--ht-secondary);\n      --chat-border: rgba(255, 255, 255, 0.14);\n      --primary-hover: var(--ht-btn-hover);\n      --secondary-hover: #3a3a42;\n      --btn-bg: var(--ht-btn-bg);\n      --btn-fg: var(--ht-btn-fg);\n      --radius-btn: var(--ht-radius-btn);\n      --radius-lg: var(--ht-radius-lg);\n      --font-display: var(--ht-font-display);\n      --font-body: var(--ht-font-body);\n      --font-wordmark: var(--ht-font-wordmark);\n    }\n\n    body {\n      font-family: var(--font-body);\n      background: var(--page-bg);\n      color: var(--ink);\n      line-height: 1.7;\n      min-height: 100vh;\n    }\n\n    /* Site Header - Floating Rounded (Homepage Style) */\n    .site-header {\n      position: sticky;\n      top: 20px;\n      z-index: 1000;\n      width: calc(100% - 40px);\n      max-width: 1344px;\n      margin: 0 auto 20px;\n      background: var(--page-bg);\n      border: 1px solid transparent;\n      border-radius: 12px;\n      box-shadow: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1);\n      transition: border-color 0.3s;\n    }\n    .site-header.scrolled { border-color: var(--divider); }\n\n    .site-header-content {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 24px;\n      height: 56px;\n    }\n\n    .site-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }\n    .site-logo img { width: 28px; height: 28px; object-fit: cover; object-position: left center; }\n    .site-logo::after { content: 'Hypertask'; color: var(--ink); font-family: var(--font-wordmark); font-size: 18px; font-weight: 700; }\n\n    .site-nav { display: flex; align-items: center; gap: 8px; }\n    .site-nav-link {\n      color: var(--muted);\n      text-decoration: none;\n      font-size: 15px;\n      font-weight: 500;\n      padding: 8px 12px;\n      border-radius: 6px;\n      transition: all 0.2s ease;\n    }\n    .site-nav-link:hover { color: var(--ink); background: rgba(255,255,255,0.1); }\n    .site-nav-link.active { color: var(--ink); }\n\n    .site-header-actions { display: flex; align-items: center; gap: 12px; }\n\n    .site-btn-login {\n      color: var(--ink);\n      background: var(--surface-hover);\n      text-decoration: none;\n      font-size: 15px;\n      font-weight: 500;\n      padding: 8px 16px;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .site-btn-login:hover { color: var(--ink); background: var(--secondary-hover); }\n\n    .site-btn-cta {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background: var(--btn-bg);\n      color: var(--btn-fg);\n      text-decoration: none;\n      font-size: 14px;\n      font-weight: 600;\n      padding: 8px 18px;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .site-btn-cta:hover { background: var(--primary-hover); }\n\n    .mobile-menu-btn {\n      display: none;\n      background: none;\n      border: none;\n      color: var(--ink);\n      cursor: pointer;\n      padding: 8px;\n    }\n\n    @media (max-width: 768px) {\n      .site-header { width: calc(100% - 16px); top: 10px; }\n      .site-header-content { padding: 0 16px; height: 48px; }\n      .site-nav { display: none; }\n      .site-btn-login { display: none; }\n      .mobile-menu-btn { display: block; }\n    }\n\n    /* Article Sub-Header */\n    .article-sub-header {\n      background: var(--page-bg);\n      padding: 12px 24px;\n      border-bottom: 1px solid var(--divider);\n    }\n    .article-sub-header-content {\n      max-width: 760px;\n      margin: 0 auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .back-link {\n      display: inline-flex; align-items: center; gap: 8px;\n      color: var(--muted); text-decoration: none;\n      font-size: 14px; font-weight: 500;\n      padding: 8px 14px; border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .back-link:hover { color: var(--ink); background: rgba(255,255,255,0.08); }\n    .header-search {\n      display: flex; align-items: center; gap: 8px;\n      color: var(--muted); font-size: 14px;\n      padding: 8px 14px;\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 8px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      text-decoration: none;\n    }\n    .header-search:hover { background: var(--surface-hover); border-color: var(--surface-border); color: var(--ink); }\n\n    /* Article Container */\n    .article-container { width: 100%; max-width: 760px; min-width: 0; margin: 0 auto; padding: 48px 24px 80px; }\n\n    /* Article Header */\n    .article-header { margin-bottom: 40px; }\n    .article-category {\n      display: inline-block;\n      font-size: 11px; font-weight: 600;\n      color: var(--ink);\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      padding: 5px 12px;\n      border-radius: 20px;\n      margin-bottom: 16px;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n    .article-title { font-family: var(--font-display); font-size: 38px; font-weight: 500; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; color: var(--ink); }\n    .article-excerpt { font-size: 18px; color: var(--muted); line-height: 1.6; }\n\n    /* Article Content */\n    .content { color: var(--ink); font-size: 16px; line-height: 1.75; min-width: 0; max-width: 100%; }\n    .table-scroll { display: block; max-width: 100%; min-width: 0; margin: 24px 0; }\n    .content p { margin-bottom: 20px; }\n    .content > div { margin-bottom: 16px; }\n    .content br { display: block; content: \"\"; margin-top: 8px; }\n    .content p:empty, .content div:empty { margin-bottom: 16px; }\n\n    .content h2 { font-family: var(--font-display); font-size: 26px; font-weight: 500; letter-spacing: -0.02em; color: var(--ink); margin: 48px 0 20px; padding-top: 24px; border-top: 1px solid var(--divider); }\n    .content h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }\n    .content h3 { font-size: 20px; font-weight: 600; color: var(--ink); margin: 32px 0 14px; }\n    .content h4 { font-size: 17px; font-weight: 600; color: var(--ink); margin: 24px 0 12px; }\n\n    .content ul, .content ol { margin: 20px 0; padding-left: 0; }\n    .content ul { list-style-type: none; }\n    .content ul li { position: relative; padding-left: 24px; margin-bottom: 10px; }\n    .content ul li::before {\n      content: '';\n      position: absolute; left: 0; top: 10px;\n      width: 6px; height: 6px;\n      background: var(--btn-bg);\n      border-radius: 50%;\n    }\n    .content ol { counter-reset: item; list-style-type: none; }\n    .content ol li { counter-increment: item; position: relative; padding-left: 32px; margin-bottom: 10px; }\n    .content ol li::before {\n      content: counter(item);\n      position: absolute; left: 0; top: 0;\n      width: 24px; height: 24px;\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      color: var(--ink);\n      font-size: 12px; font-weight: 600;\n      border-radius: 50%;\n      display: flex; align-items: center; justify-content: center;\n    }\n\n    .content code {\n      background: var(--surface-hover);\n      color: var(--ink);\n      padding: 3px 8px;\n      border-radius: 6px;\n      font-size: 14px;\n      font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;\n    }\n    .content pre {\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 12px;\n      padding: 20px 24px;\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      max-width: 100%;\n      margin: 24px 0;\n    }\n    .content pre code { background: none; color: rgba(255,255,255,0.85); padding: 0; font-size: 14px; line-height: 1.7; }\n    .content kbd {\n      display: inline-block;\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      border-radius: 6px;\n      padding: 4px 8px;\n      font-size: 13px;\n      font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;\n      font-weight: 500;\n      color: var(--ink);\n      box-shadow: 0 2px 0 rgba(0,0,0,0.3);\n      margin: 0 2px;\n      white-space: nowrap;\n    }\n    .content a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; transition: opacity 0.2s ease; }\n    .content a:hover { opacity: 0.8; text-decoration: underline; text-underline-offset: 3px; }\n    .content blockquote {\n      border-left: 3px solid var(--ink);\n      padding: 16px 24px;\n      margin: 24px 0;\n      background: var(--surface);\n      border-radius: 0 12px 12px 0;\n      color: var(--muted);\n      font-style: italic;\n    }\n    .content img { max-width: 100%; height: auto; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content iframe { max-width: 100%; width: 100%; aspect-ratio: 16/9; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content video { max-width: 100%; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content strong { color: var(--ink); font-weight: 600; }\n    .content table { width: 100%; min-width: 100%; border-collapse: collapse; margin: 0; font-size: 15px; }\n    .content th, .content td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--divider); }\n    .content th { background: rgba(255,255,255,0.08) !important; color: var(--ink) !important; font-weight: 600; }\n    .content thead tr { background: rgba(255,255,255,0.08) !important; }\n    .content tr:hover td { background: rgba(255,255,255,0.02); }\n    .content hr { border: none; border-top: 1px solid var(--divider); margin: 48px 0; }\n\n    /* Article Footer */\n    .article-footer { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--divider); }\n    .article-footer-text { color: var(--muted); font-size: 15px; text-align: center; margin-bottom: 20px; }\n    .feedback-buttons { display: flex; justify-content: center; gap: 12px; }\n    .feedback-btn {\n      display: inline-flex; align-items: center; gap: 8px;\n      padding: 12px 24px;\n      border: none;\n      border-radius: 8px;\n      background: var(--btn-bg);\n      color: var(--btn-fg);\n      font-size: 14px;\n      font-weight: 600;\n      font-family: inherit;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n    .feedback-btn:hover { background: var(--primary-hover); transform: scale(1.03); }\n    .feedback-btn svg { stroke: var(--btn-fg); }\n\n    /* Related Articles */\n    .related-articles {\n      margin-top: 48px;\n      padding: 28px;\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 12px;\n    }\n    .related-title { font-size: 16px; font-weight: 600; color: var(--ink); margin-bottom: 16px; }\n    .related-link {\n      display: block; padding: 12px 0;\n      color: var(--muted); text-decoration: none;\n      font-size: 14px;\n      border-bottom: 1px solid var(--divider);\n      transition: all 0.2s ease;\n    }\n    .related-link:last-child { border-bottom: none; }\n    .related-link:hover { color: var(--ink); padding-left: 6px; }\n\n    /* Responsive */\n    @media (max-width: 640px) {\n      .article-container { padding: 32px 16px 64px; }\n      .article-title { font-size: 28px; }\n      .article-excerpt { font-size: 16px; }\n      .content h2 { font-size: 22px; }\n      .content h3 { font-size: 18px; }\n      .header-search { display: none; }\n      .feedback-btn { padding: 10px 18px; font-size: 14px; }\n    }\n\n  </style>\n</head>\n<body>\n  <!-- Hypertask Site Header -->\n  <header class=\"site-header\">\n    <div class=\"site-header-content\">\n      <a href=\"https://hypertask.ai\" class=\"site-logo\">\n        <img src=\"https://hypertask.ai/hypertask_white.png\" alt=\"Hypertask\" />\n      </a>\n      <nav class=\"site-nav\">\n        <a href=\"https://hypertask.ai/pricing/\" class=\"site-nav-link\">Pricing</a>\n        <a href=\"https://hypertask.ai/blog/\" class=\"site-nav-link\">Blog</a>\n        <a href=\"https://docs.hypertask.ai/\" class=\"site-nav-link\">Docs</a>\n        <a href=\"/help\" class=\"site-nav-link active\">Help</a>\n      </nav>\n      <div class=\"site-header-actions\">\n        <a href=\"https://app.hypertask.ai/login\" class=\"site-btn-login\">Login</a>\n        <a href=\"https://app.hypertask.ai/login\" class=\"site-btn-cta\">Start Free</a>\n        <button class=\"mobile-menu-btn\" aria-label=\"Menu\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n            <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n            <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n          </svg>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Article Sub-Header with Back Link -->\n  <div class=\"article-sub-header\">\n    <div class=\"article-sub-header-content\">\n      <a href=\"/help\" class=\"back-link\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"m15 18-6-6 6-6\"></path>\n        </svg>\n        Back to Help Center\n      </a>\n      <a href=\"/help\" class=\"header-search\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n          <path d=\"m21 21-4.35-4.35\"></path>\n        </svg>\n        Search\n      </a>\n    </div>\n  </div>\n\n  <article class=\"article-container\">\n    <header class=\"article-header\">\n      <span class=\"article-category\">Getting Started</span>\n      <h1 class=\"article-title\">What is Hypertask?</h1>\n      \n      <p class=\"article-excerpt\">AI-native project management for teams and AI agents — manage tasks, collaborate in real-time, and connect AI agents with MCP, CLI, and REST APIs.</p>\n    </header>\n\n    <div class=\"content\">\n      <h1>What is Hypertask?</h1>\n<p><strong>AI-native collaboration</strong></p>\n<p>Built with agents first. Hypertask comes with an intelligent co-worker that can read your board, create tasks, and respond to comments—all via Chat, CLI, MCP, or REST.</p>\n<p><strong>Full control, no lock-in</strong></p>\n<p>Use built-in or programmatic auth. The CLI, MCP and REST APIs cover every piece of your workflow, so you own the experience.</p>\n<p><strong>Workspace-ready</strong></p>\n<p>Multi-tenant workspaces with optional boards per workspace, team invites, role-based permissions, and real-time collaboration for many teams.</p>\n<p><strong>Modern UX</strong></p>\n<p>Clean Kanban boards, calendar views, a unified Inbox for mentions and updates, and a Theme picker supporting Light, Dark, AMOLED, and custom Paper theme.</p>\n<h2>Setup options</h2>\n<p>Whether you prefer a browser UI, the command line, or integrating via code, there's a path that fits your workflow.</p>\n<h3>Browser</h3>\n<p>Sign in with email on <code>app.hypertask.ai</code> to start collaborating immediately. Invite your team and start adding tasks, boards, and workflows.</p>\n<h3>CLI</h3>\n<p>Manage and create tasks from the terminal with the <code>hypertask</code> CLI. Install via your package manager, login, and start creating.</p>\n<ol><li>Install the CLI via npm or homebrew.</li><li>Run <code>hypertask login</code> and follow the on-screen prompts.</li><li>Use commands like <code>hypertask task create</code>, <code>hypertask task list</code>, and <code>hypertask comment add</code> from your shell.</li></ol>\n<h3>MCP</h3>\n<p>Connect Hypertask to your AI agents via the Model Context Protocol. The MCP server exposes tools for tasks, boards, chat, and more.</p>\n<ol><li>Add the Hypertask MCP endpoint to your LM Studio, Claude Desktop, or another MCP-compatible client.</li><li>Authenticate with a Bearer token or session cookie.</li><li>Use <code>hypertask_tasks</code> for task creation and assignment, and <code>hypertask_comments</code> for replies.</li></ol>\n<h3>REST API</h3>\n<p>Use our REST API to build integration or mobile apps. Seeds, boards, views, tasks, comments, and more are all reachable via simple HTTP requests.</p>\n<ol><li>Get an API key from the Settings sidebar in the app.</li><li>Add <code>Authorization: Bearer &amp;lt;key&amp;gt;</code> headers to your requests.</li><li>Use endpoints like <code>GET /boards</code>, <code>POST /tasks</code>, <code>POST /messages/chat</code>, and more.</li></ol>\n<h2>Core concepts</h2>\n<p>Here's a quick overview of the key concepts you'll use in Hypertask.</p>\n<div class=\"table-scroll\" style=\"overflow-x:auto;-webkit-overflow-scrolling:touch\"><table><thead><tr><th>Concept</th><th>Description</th></tr></thead><tbody><tr><td><strong>Workspace</strong></td><td>The top-level container for your organization. Board owners can choose whether a board belongs to one workspace or automatically inherits from the owner.</td></tr><tr><td><strong>Board</strong></td><td>A flexible surface for organizing work: Kanban columns, tables, lists, or calendars. Boards contain sections, views, and tasks.</td></tr><tr><td><strong>Section</strong></td><td>A column on a Kanban board with tasks that share a common state or trigger. Sections support drag-to-reorder.</td></tr><tr><td><strong>View</strong></td><td>A custom perspective on a board—filtering, sorting, grouping, or hiding tasks. Views can be pinned, hidden, or deleted as needed.</td></tr><tr><td><strong>Task</strong></td><td>A unit of work with a title, description, assignee, tags, subtasks, and relations with other tasks and issues.</td></tr><tr><td><strong>Chat</strong></td><td>An in-app AI assistant that understands your context—tasks, boards, messages, and more. You can create and edit saved GPTs, speed up writing, and control agents and time tracking.</td></tr><tr><td><strong>Inbox</strong></td><td>A unified feed of mentions, important items, reactions, and updates across your boards. Unread items are highlighted and accessible via keyboard navigation.</td></tr><tr><td><strong>Agents</strong></td><td>Autonomous AI agents that can pull context from your board, create and update tasks, respond to comments, run schedules, and interact with your workspace via tools.</td></tr></tbody></table></div>\n<p>It's Email-native, but not Firebase-dependent. Hypertask uses Better Auth and your own SMTP for signing in, with Firebase kept exclusively for push notifications. You can also integrate via CLI, MCP, or REST without going through the app UI at all.</p>\n<h2>Getting started</h2>\n<ol><li>Create an account or sign in with email/app password at <a href=\"https://app.hypertask.ai\" target=\"_blank\" rel=\"noopener noreferrer\">app.hypertask.ai</a>.</li><li>Request a new sign-in link if your browser session expires or is shared; links are single-use, so each click gives you a fresh sign-in.</li><li>Request a new verification link when creating a new account; never reuse old verification emails.</li><li>Set your preferred theme using the <kbd>Ctrl+K</kbd> command palette or the Theme picker in Settings (Light, Dark, System, AMOLED, Paper).</li><li><strong>For email signups:</strong> You land directly on a board and receive a welcome email containing install steps for Claude Code / Cursor MCP along with a link to your board.</li><li>Invite teammates to your workspace and create your first board (Kanban, Table, List, or Calendar).</li><li>Start adding tasks, tagging them for organization, and assigning them.</li><li>Use <kbd>Ctrl+K</kbd> to access the command palette for quick navigation and actions.</li><li>Chat with the AI assistant to create tasks, summarize boards, or brainstorm without leaving the page.</li><li>Optional: install the CLI or set up an MCP agent for programmatic control over your tasks.</li></ol>\n<h2>Keyboard shortcuts</h2>\n<p>Hypertask has a rich set of keyboard shortcuts across surfaces. Press <kbd>Ctrl+K</kbd> to open the command palette and search for shortcuts by name.</p>\n<p>Depending on your OS, <kbd>Ctrl</kbd> is <kbd>Control</kbd> on Windows/Linux and ⌘ on macOS.</p>\n<p><code>Ctrl+K</code> — Open command palette for shortcuts and actions.</p>\n<p><code>Ctrl+G</code> — Navigate surfaces (Inbox → Boards → My Tasks → Chat), as needed.</p>\n<h3>Live shortcuts</h3>\n<p>The command palette shows all shortcuts relevant to your current context, such as boards, tasks, inbox, and chat. Hover over a shortcut to see its location (modal, board surface, or button).</p>\n<h3>Keyboard hints in the UI</h3>\n<p>The header's <strong>Login</strong> button shows a &quot;Press L to log in&quot; tooltip when you hover over it or focus it with the keyboard. This hint highlights the visual keycap style for improved discoverability and accessibility.</p>\n<h2>Onboarding</h2>\n<p>First-time users see an <strong>Onboarding Tour</strong> when they sign in. You can replay it at any time by pressing <kbd>Ctrl+K</kbd>, searching for &quot;Onboarding tour&quot;, and selecting the replay option.</p>\n<p>The tour walks you through connecting AI, creating your first board, and using key features. Invited teammates see a trimmed version that skips heavy setup but still introduces essential workflows.</p>\n<h2>Security, auth, and permissions</h2>\n<p>Hypertask uses server-side authentication and ensures that other users' data never leaks into your boards or views. Here are some key principles:</p>\n<ul><li><strong>Email sign-in &amp; Better Auth</strong>: Sign in is handled server-side. Email login takes you directly to your board; magic-links and sign-out remain functional.</li><li><strong>Firebase for push only</strong>: Firebase Auth is not used for login or signup. Firebase is strictly for FCM push notifications.</li><li><strong>Route cleanup</strong>: Dead authentication routes that no longer exist (e.g. old signup or password reset paths) return 404, and CORS carve-outs are removed for production security.</li><li><strong>Session integrity via signed ht_session cookies</strong>: API routes validate signed <code>ht_session</code> cookies alongside <code>nookies_user</code>, ensuring that forging cookies cannot be used for cookie spoofing.</li><li><strong>PostHog cross-domain visitor identity</strong>: Signin and load attribution between <code>hypertask.ai</code> and <code>app.hypertask.ai</code> use signed ht_session cookies, avoiding client-side cookie dependency.</li><li><strong>Strict account linking</strong>: Linking a Google login to an unverified local account is blocked, ensuring verified local accounts are not orphaned.</li><li><strong>Multi-tenant isolation</strong>: By design, boards, views, and tasks belong to the user. Archive and other features show only your data unless explicitly shared.</li><li><strong>Single-use login and verification links</strong>: When you request a new sign-in link or account verification email, the link is valid for one use only. Attempting to reuse a link shows an &quot;invalid or expired&quot; message and does not grant a session.</li><li><strong>Board-level access for files</strong>: Only people who can see a ticket can download its attachments. Access is scoped to the task: observers outside the ticket cannot reach files and previews, even if they can view the board.</li></ul>\n<p>For finer-grained security, you can use the REST API to enforce claims, tokens, and additional checks for your integrations.</p>\n<h2>Frequently asked questions</h2>\n<p>&lt;details&gt; &lt;summary&gt;Is Hypertask free?&lt;/summary&gt;</p>\n<p>The Free plan includes unlimited members and unlimited open tickets. You can own up to 3 boards. Archived boards are not counted. A paid or comped plan has no board limit. See <a href=\"https://docs.hypertask.ai/features/billing/\" target=\"_blank\" rel=\"noopener noreferrer\">Billing &amp; Seat Management</a> for details. &lt;/details&gt;</p>\n<p>&lt;details&gt; &lt;summary&gt;Can I export my tasks?&lt;/summary&gt;</p>\n<p>Yes. Export options include CSV, JSON, and integrations with IDEs, build tools, and CI/CD pipelines using the CLI and REST API. &lt;/details&gt;</p>\n<p>&lt;details&gt; &lt;summary&gt;Is there a mobile app?&lt;/summary&gt;</p>\n<p>Yes. Android has an official app, and iPhone and other phones install the web app with Add to Home Screen. See <a href=\"https://docs.hypertask.ai/getting-started/apps/\" target=\"_blank\" rel=\"noopener noreferrer\">Mobile and desktop apps</a>. &lt;/details&gt;</p>\n<p>&lt;details&gt; &lt;summary&gt;Is there a desktop app for Windows or Mac?&lt;/summary&gt;</p>\n<p>Use the web app in a browser, or install it as an app. There is no signed desktop download. See <a href=\"https://docs.hypertask.ai/getting-started/apps/\" target=\"_blank\" rel=\"noopener noreferrer\">Mobile and desktop apps</a>. &lt;/details&gt;</p>\n    </div>\n\n    <footer class=\"article-footer\">\n      <p class=\"article-footer-text\">Was this article helpful?</p>\n      <div class=\"feedback-buttons\">\n        <button class=\"feedback-btn\" onclick=\"this.innerHTML='Thanks for the feedback!'\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M7 10v12\"></path>\n            <path d=\"M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z\"></path>\n          </svg>\n          Yes\n        </button>\n        <button class=\"feedback-btn\" onclick=\"this.innerHTML='Thanks for the feedback!'\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M17 14V2\"></path>\n            <path d=\"M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z\"></path>\n          </svg>\n          No\n        </button>\n      </div>\n    </footer>\n\n    \n    <div class=\"related-articles\">\n      <h3 class=\"related-title\">Related Articles</h3>\n      \n        <a href=\"/help/docs-getting-started-concepts\" class=\"related-link\">Core Concepts</a>\n      \n        <a href=\"/help/docs-getting-started-contact-support\" class=\"related-link\">Get help</a>\n      \n        <a href=\"/help/docs-getting-started-apps\" class=\"related-link\">Mobile and desktop apps</a>\n      \n    </div>\n  \n  </article>\n\n  <script src=\"/widget/widget.js\"></script>\n  <script>\n    (function() {\n      var header = document.querySelector('.site-header');\n      if (!header) return;\n      window.addEventListener('scroll', function() {\n        if (window.scrollY > 0) {\n          header.classList.add('scrolled');\n        } else {\n          header.classList.remove('scrolled');\n        }\n      });\n    })();\n  </script>\n</body>\n</html>"
}
