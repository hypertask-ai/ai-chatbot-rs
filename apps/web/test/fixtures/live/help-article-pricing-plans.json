{
  "method": "curl, GET only, no chat message sent, no cookies and no visitor data",
  "recorded": "2026-11-15",
  "source": "https://help.hypertask.ai/help/pricing-plans",
  "body": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content\">\n  <title>Hypertask pricing, free trial and Free plan limits - Help Center - Hypertask</title>\n  <meta name=\"description\" content=\"Free is $0 forever, with unlimited members, unlimited open tickets and up to 3 owned boards. Paid plans per user per month: BYOK $10 monthly or $8 billed yearly, Pro $20 monthly or $16 billed yearly. Paid plans come with a 14-day trial. Upgrade in Settings > Plans.\">\n  <link rel=\"icon\" type=\"image/png\" href=\"https://hypertask.ai/glyph-white.png\">\n  <script src=\"https://cdn.usefathom.com/script.js\" data-site=\"SSBYTYUQ\" defer></script>\n  \n  \n  <style type=\"text/css\">@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/cyrillic/700/normal.woff2);unicode-range:U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/latin-ext/700/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/vietnamese/700/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/cyrillic-ext/700/normal.woff2);unicode-range:U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F;font-display:swap;}@font-face {font-family:'IBM Plex Mono';font-style:normal;font-weight:700;src:url(/cf-fonts/s/ibm-plex-mono/5.2.7/latin/700/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/latin/wght/normal.woff2);unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/latin-ext/wght/normal.woff2);unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;font-display:swap;}@font-face {font-family:'Newsreader';font-style:normal;font-weight:500;src:url(/cf-fonts/v/newsreader/5.2.10/vietnamese/wght/normal.woff2);unicode-range:U+0102-0103,U+0110-0111,U+0128-0129,U+0168-0169,U+01A0-01A1,U+01AF-01B0,U+0300-0301,U+0303-0304,U+0308-0309,U+0323,U+0329,U+1EA0-1EF9,U+20AB;font-display:swap;}</style>\n  <style>\n    * { margin: 0; padding: 0; box-sizing: border-box; }\n\n    :root {\n      /* Source: https://hypertask.ai homepage CSS (.h1x, .h1-btn-primary), fetched 2026-10-25. */\n      --ht-p1: #000000;\n      --ht-p2: #0b0b0d;\n      --ht-ink: #f4f4f7;\n      --ht-ink-2: rgba(244, 244, 247, 0.64);\n      --ht-ink-3: rgba(244, 244, 247, 0.40);\n      --ht-line: rgba(244, 244, 247, 0.10);\n      --ht-line-2: rgba(244, 244, 247, 0.16);\n      --ht-btn-bg: #ffffff;\n      --ht-btn-fg: #000000;\n      --ht-btn-hover: #d9d9d9;\n      --ht-radius-btn: 8px;\n      --ht-radius-lg: 14px;\n      --ht-font-display: \"Newsreader\", Georgia, serif;\n      --ht-font-body: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n      --ht-font-wordmark: \"IBM Plex Mono\", ui-monospace, monospace;\n\n      --ht-secondary: #262626;\n      --page-bg: #000000;\n      --surface: #0b0b0d;\n      --surface-hover: #191a1e;\n      --ink: var(--ht-ink);\n      --muted: #a7a8ad;\n      --surface-border: rgba(255, 255, 255, 0.14);\n      --divider: rgba(255, 255, 255, 0.10);\n      --chat-bg: var(--ht-secondary);\n      --chat-border: rgba(255, 255, 255, 0.14);\n      --primary-hover: var(--ht-btn-hover);\n      --secondary-hover: #3a3a42;\n      --btn-bg: var(--ht-btn-bg);\n      --btn-fg: var(--ht-btn-fg);\n      --radius-btn: var(--ht-radius-btn);\n      --radius-lg: var(--ht-radius-lg);\n      --font-display: var(--ht-font-display);\n      --font-body: var(--ht-font-body);\n      --font-wordmark: var(--ht-font-wordmark);\n    }\n\n    body {\n      font-family: var(--font-body);\n      background: var(--page-bg);\n      color: var(--ink);\n      line-height: 1.7;\n      min-height: 100vh;\n    }\n\n    /* Site Header - Floating Rounded (Homepage Style) */\n    .site-header {\n      position: sticky;\n      top: 20px;\n      z-index: 1000;\n      width: calc(100% - 40px);\n      max-width: 1344px;\n      margin: 0 auto 20px;\n      background: var(--page-bg);\n      border: 1px solid transparent;\n      border-radius: 12px;\n      box-shadow: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -4px rgba(0,0,0,.1);\n      transition: border-color 0.3s;\n    }\n    .site-header.scrolled { border-color: var(--divider); }\n\n    .site-header-content {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 24px;\n      height: 56px;\n    }\n\n    .site-logo { display: flex; align-items: center; gap: 10px; text-decoration: none; flex-shrink: 0; }\n    .site-logo img { width: 28px; height: 28px; object-fit: cover; object-position: left center; }\n    .site-logo::after { content: 'Hypertask'; color: var(--ink); font-family: var(--font-wordmark); font-size: 18px; font-weight: 700; }\n\n    .site-nav { display: flex; align-items: center; gap: 8px; }\n    .site-nav-link {\n      color: var(--muted);\n      text-decoration: none;\n      font-size: 15px;\n      font-weight: 500;\n      padding: 8px 12px;\n      border-radius: 6px;\n      transition: all 0.2s ease;\n    }\n    .site-nav-link:hover { color: var(--ink); background: rgba(255,255,255,0.1); }\n    .site-nav-link.active { color: var(--ink); }\n\n    .site-header-actions { display: flex; align-items: center; gap: 12px; }\n\n    .site-btn-login {\n      color: var(--ink);\n      background: var(--surface-hover);\n      text-decoration: none;\n      font-size: 15px;\n      font-weight: 500;\n      padding: 8px 16px;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .site-btn-login:hover { color: var(--ink); background: var(--secondary-hover); }\n\n    .site-btn-cta {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n      background: var(--btn-bg);\n      color: var(--btn-fg);\n      text-decoration: none;\n      font-size: 14px;\n      font-weight: 600;\n      padding: 8px 18px;\n      border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .site-btn-cta:hover { background: var(--primary-hover); }\n\n    .mobile-menu-btn {\n      display: none;\n      background: none;\n      border: none;\n      color: var(--ink);\n      cursor: pointer;\n      padding: 8px;\n    }\n\n    @media (max-width: 768px) {\n      .site-header { width: calc(100% - 16px); top: 10px; }\n      .site-header-content { padding: 0 16px; height: 48px; }\n      .site-nav { display: none; }\n      .site-btn-login { display: none; }\n      .mobile-menu-btn { display: block; }\n    }\n\n    /* Article Sub-Header */\n    .article-sub-header {\n      background: var(--page-bg);\n      padding: 12px 24px;\n      border-bottom: 1px solid var(--divider);\n    }\n    .article-sub-header-content {\n      max-width: 760px;\n      margin: 0 auto;\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n    }\n    .back-link {\n      display: inline-flex; align-items: center; gap: 8px;\n      color: var(--muted); text-decoration: none;\n      font-size: 14px; font-weight: 500;\n      padding: 8px 14px; border-radius: 8px;\n      transition: all 0.2s ease;\n    }\n    .back-link:hover { color: var(--ink); background: rgba(255,255,255,0.08); }\n    .header-search {\n      display: flex; align-items: center; gap: 8px;\n      color: var(--muted); font-size: 14px;\n      padding: 8px 14px;\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 8px;\n      cursor: pointer;\n      transition: all 0.2s ease;\n      text-decoration: none;\n    }\n    .header-search:hover { background: var(--surface-hover); border-color: var(--surface-border); color: var(--ink); }\n\n    /* Article Container */\n    .article-container { width: 100%; max-width: 760px; min-width: 0; margin: 0 auto; padding: 48px 24px 80px; }\n\n    /* Article Header */\n    .article-header { margin-bottom: 40px; }\n    .article-category {\n      display: inline-block;\n      font-size: 11px; font-weight: 600;\n      color: var(--ink);\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      padding: 5px 12px;\n      border-radius: 20px;\n      margin-bottom: 16px;\n      text-transform: uppercase;\n      letter-spacing: 0.05em;\n    }\n    .article-title { font-family: var(--font-display); font-size: 38px; font-weight: 500; line-height: 1.15; letter-spacing: -0.02em; margin-bottom: 16px; color: var(--ink); }\n    .article-excerpt { font-size: 18px; color: var(--muted); line-height: 1.6; }\n\n    /* Article Content */\n    .content { color: var(--ink); font-size: 16px; line-height: 1.75; min-width: 0; max-width: 100%; }\n    .table-scroll { display: block; max-width: 100%; min-width: 0; margin: 24px 0; }\n    .content p { margin-bottom: 20px; }\n    .content > div { margin-bottom: 16px; }\n    .content br { display: block; content: \"\"; margin-top: 8px; }\n    .content p:empty, .content div:empty { margin-bottom: 16px; }\n\n    .content h2 { font-family: var(--font-display); font-size: 26px; font-weight: 500; letter-spacing: -0.02em; color: var(--ink); margin: 48px 0 20px; padding-top: 24px; border-top: 1px solid var(--divider); }\n    .content h2:first-child { margin-top: 0; padding-top: 0; border-top: none; }\n    .content h3 { font-size: 20px; font-weight: 600; color: var(--ink); margin: 32px 0 14px; }\n    .content h4 { font-size: 17px; font-weight: 600; color: var(--ink); margin: 24px 0 12px; }\n\n    .content ul, .content ol { margin: 20px 0; padding-left: 0; }\n    .content ul { list-style-type: none; }\n    .content ul li { position: relative; padding-left: 24px; margin-bottom: 10px; }\n    .content ul li::before {\n      content: '';\n      position: absolute; left: 0; top: 10px;\n      width: 6px; height: 6px;\n      background: var(--btn-bg);\n      border-radius: 50%;\n    }\n    .content ol { counter-reset: item; list-style-type: none; }\n    .content ol li { counter-increment: item; position: relative; padding-left: 32px; margin-bottom: 10px; }\n    .content ol li::before {\n      content: counter(item);\n      position: absolute; left: 0; top: 0;\n      width: 24px; height: 24px;\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      color: var(--ink);\n      font-size: 12px; font-weight: 600;\n      border-radius: 50%;\n      display: flex; align-items: center; justify-content: center;\n    }\n\n    .content code {\n      background: var(--surface-hover);\n      color: var(--ink);\n      padding: 3px 8px;\n      border-radius: 6px;\n      font-size: 14px;\n      font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;\n    }\n    .content pre {\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 12px;\n      padding: 20px 24px;\n      overflow-x: auto;\n      -webkit-overflow-scrolling: touch;\n      max-width: 100%;\n      margin: 24px 0;\n    }\n    .content pre code { background: none; color: rgba(255,255,255,0.85); padding: 0; font-size: 14px; line-height: 1.7; }\n    .content kbd {\n      display: inline-block;\n      background: var(--surface-hover);\n      border: 1px solid var(--surface-border);\n      border-radius: 6px;\n      padding: 4px 8px;\n      font-size: 13px;\n      font-family: 'SF Mono', 'Consolas', 'Monaco', monospace;\n      font-weight: 500;\n      color: var(--ink);\n      box-shadow: 0 2px 0 rgba(0,0,0,0.3);\n      margin: 0 2px;\n      white-space: nowrap;\n    }\n    .content a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; transition: opacity 0.2s ease; }\n    .content a:hover { opacity: 0.8; text-decoration: underline; text-underline-offset: 3px; }\n    .content blockquote {\n      border-left: 3px solid var(--ink);\n      padding: 16px 24px;\n      margin: 24px 0;\n      background: var(--surface);\n      border-radius: 0 12px 12px 0;\n      color: var(--muted);\n      font-style: italic;\n    }\n    .content img { max-width: 100%; height: auto; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content iframe { max-width: 100%; width: 100%; aspect-ratio: 16/9; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content video { max-width: 100%; border-radius: 12px; margin: 24px 0; border: 1px solid var(--divider); }\n    .content strong { color: var(--ink); font-weight: 600; }\n    .content table { width: 100%; min-width: 100%; border-collapse: collapse; margin: 0; font-size: 15px; }\n    .content th, .content td { padding: 12px 16px; text-align: left; border-bottom: 1px solid var(--divider); }\n    .content th { background: rgba(255,255,255,0.08) !important; color: var(--ink) !important; font-weight: 600; }\n    .content thead tr { background: rgba(255,255,255,0.08) !important; }\n    .content tr:hover td { background: rgba(255,255,255,0.02); }\n    .content hr { border: none; border-top: 1px solid var(--divider); margin: 48px 0; }\n\n    /* Article Footer */\n    .article-footer { margin-top: 64px; padding-top: 32px; border-top: 1px solid var(--divider); }\n    .article-footer-text { color: var(--muted); font-size: 15px; text-align: center; margin-bottom: 20px; }\n    .feedback-buttons { display: flex; justify-content: center; gap: 12px; }\n    .feedback-btn {\n      display: inline-flex; align-items: center; gap: 8px;\n      padding: 12px 24px;\n      border: none;\n      border-radius: 8px;\n      background: var(--btn-bg);\n      color: var(--btn-fg);\n      font-size: 14px;\n      font-weight: 600;\n      font-family: inherit;\n      cursor: pointer;\n      transition: all 0.2s ease;\n    }\n    .feedback-btn:hover { background: var(--primary-hover); transform: scale(1.03); }\n    .feedback-btn svg { stroke: var(--btn-fg); }\n\n    /* Related Articles */\n    .related-articles {\n      margin-top: 48px;\n      padding: 28px;\n      background: var(--surface);\n      border: 1px solid var(--surface-border);\n      border-radius: 12px;\n    }\n    .related-title { font-size: 16px; font-weight: 600; color: var(--ink); margin-bottom: 16px; }\n    .related-link {\n      display: block; padding: 12px 0;\n      color: var(--muted); text-decoration: none;\n      font-size: 14px;\n      border-bottom: 1px solid var(--divider);\n      transition: all 0.2s ease;\n    }\n    .related-link:last-child { border-bottom: none; }\n    .related-link:hover { color: var(--ink); padding-left: 6px; }\n\n    /* Responsive */\n    @media (max-width: 640px) {\n      .article-container { padding: 32px 16px 64px; }\n      .article-title { font-size: 28px; }\n      .article-excerpt { font-size: 16px; }\n      .content h2 { font-size: 22px; }\n      .content h3 { font-size: 18px; }\n      .header-search { display: none; }\n      .feedback-btn { padding: 10px 18px; font-size: 14px; }\n    }\n\n  </style>\n</head>\n<body>\n  <!-- Hypertask Site Header -->\n  <header class=\"site-header\">\n    <div class=\"site-header-content\">\n      <a href=\"https://hypertask.ai\" class=\"site-logo\">\n        <img src=\"https://hypertask.ai/hypertask_white.png\" alt=\"Hypertask\" />\n      </a>\n      <nav class=\"site-nav\">\n        <a href=\"https://hypertask.ai/pricing/\" class=\"site-nav-link\">Pricing</a>\n        <a href=\"https://hypertask.ai/blog/\" class=\"site-nav-link\">Blog</a>\n        <a href=\"https://docs.hypertask.ai/\" class=\"site-nav-link\">Docs</a>\n        <a href=\"/help\" class=\"site-nav-link active\">Help</a>\n      </nav>\n      <div class=\"site-header-actions\">\n        <a href=\"https://app.hypertask.ai/login\" class=\"site-btn-login\">Login</a>\n        <a href=\"https://app.hypertask.ai/login\" class=\"site-btn-cta\">Start Free</a>\n        <button class=\"mobile-menu-btn\" aria-label=\"Menu\">\n          <svg width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <line x1=\"3\" y1=\"12\" x2=\"21\" y2=\"12\"></line>\n            <line x1=\"3\" y1=\"6\" x2=\"21\" y2=\"6\"></line>\n            <line x1=\"3\" y1=\"18\" x2=\"21\" y2=\"18\"></line>\n          </svg>\n        </button>\n      </div>\n    </div>\n  </header>\n\n  <!-- Article Sub-Header with Back Link -->\n  <div class=\"article-sub-header\">\n    <div class=\"article-sub-header-content\">\n      <a href=\"/help\" class=\"back-link\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"m15 18-6-6 6-6\"></path>\n        </svg>\n        Back to Help Center\n      </a>\n      <a href=\"/help\" class=\"header-search\">\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <circle cx=\"11\" cy=\"11\" r=\"8\"></circle>\n          <path d=\"m21 21-4.35-4.35\"></path>\n        </svg>\n        Search\n      </a>\n    </div>\n  </div>\n\n  <article class=\"article-container\">\n    <header class=\"article-header\">\n      <span class=\"article-category\">Getting Started</span>\n      <h1 class=\"article-title\">Hypertask pricing, free trial and Free plan limits</h1>\n      <section class=\"plan-board\" aria-label=\"Hypertask plans\">\n    <style>\n.plan-board { margin: 8px 0 28px; color: var(--ink, #f4f4f7); container-type: inline-size; }\n.plan-board * { box-sizing: border-box; }\n.plan-toggle {\n  position: relative;\n  display: flex;\n  width: fit-content;\n  max-width: 100%;\n  gap: 4px;\n  padding: 4px;\n  margin-bottom: 16px;\n  background: var(--surface, #0b0b0d);\n  border: 1px solid var(--surface-border, rgba(255,255,255,0.14));\n  border-radius: 10px;\n}\n.plan-billing-input {\n  position: absolute;\n  opacity: 0;\n  width: 1px;\n  height: 1px;\n  margin: 0;\n}\n.plan-toggle label {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 36px;\n  padding: 6px 14px;\n  border-radius: 8px;\n  color: var(--muted, #a7a8ad);\n  font-size: 14px;\n  font-weight: 600;\n  cursor: pointer;\n}\n.plan-billing-input:checked + label {\n  background: var(--btn-bg, #ffffff);\n  color: var(--btn-fg, #000000);\n}\n.plan-billing-input:focus-visible + label { outline: 2px solid var(--ink, #f4f4f7); outline-offset: 2px; }\n.plan-save { font-size: 12px; font-weight: 700; }\n.plan-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }\n.plan-card {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 18px 16px 16px;\n  background: var(--surface, #0b0b0d);\n  border: 1px solid var(--surface-border, rgba(255,255,255,0.14));\n  border-radius: var(--radius-lg, 14px);\n}\n.plan-name {\n  font-family: var(--font-display, Georgia, serif);\n  font-size: 26px;\n  font-weight: 500;\n  letter-spacing: -0.02em;\n  line-height: 1.1;\n}\n.plan-who { margin: 8px 0 14px; color: var(--muted, #a7a8ad); font-size: 14px; line-height: 1.4; }\n.plan-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; margin: 0; }\n.plan-amount { font-size: 32px; font-weight: 650; letter-spacing: -0.03em; line-height: 1; }\n.plan-unit, .plan-detail, .plan-alt { color: var(--muted, #a7a8ad); font-size: 13px; line-height: 1.4; }\n.plan-detail, .plan-alt { margin: 4px 0 0; }\n.plan-points { list-style: none; margin: 16px 0; padding: 0; flex: 1; }\n.plan-points li { position: relative; margin: 0 0 8px; padding-left: 16px; font-size: 14px; line-height: 1.4; }\n.plan-points li::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 0.5em;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--ink, #f4f4f7);\n}\n.plan-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-height: 40px;\n  padding: 8px 14px;\n  background: var(--btn-bg, #ffffff);\n  color: var(--btn-fg, #000000);\n  border-radius: var(--radius-btn, 8px);\n  font-size: 14px;\n  font-weight: 600;\n  text-decoration: none;\n}\n.plan-cta:hover { background: var(--primary-hover, #d9d9d9); }\n.plan-note { margin: 14px 0 0; color: var(--muted, #a7a8ad); font-size: 14px; line-height: 1.5; }\n.plan-note a { color: var(--ink, #f4f4f7); white-space: nowrap; }\n.plan-board .price-monthly { display: none; }\n.plan-board:has(#ht-plan-monthly:checked) .price-yearly { display: none; }\n.plan-board:has(#ht-plan-monthly:checked) .price-monthly { display: block; }\n.plan-board:has(#ht-plan-monthly:checked) .plan-price .price-monthly { display: inline; }\n@container (max-width: 640px) {\n  .plan-grid { grid-template-columns: 1fr; }\n  .plan-toggle { width: 100%; }\n  .plan-toggle label { flex: 1; }\n}\n</style>\n    <div class=\"plan-toggle\" role=\"radiogroup\" aria-label=\"Billing period\">\n      <input class=\"plan-billing-input\" type=\"radio\" name=\"ht-plan-billing\" id=\"ht-plan-monthly\">\n      <label for=\"ht-plan-monthly\">Monthly</label>\n      <input class=\"plan-billing-input\" type=\"radio\" name=\"ht-plan-billing\" id=\"ht-plan-yearly\" checked>\n      <label for=\"ht-plan-yearly\">Yearly <span class=\"plan-save\">save 20%</span></label>\n    </div>\n    <div class=\"plan-grid\"><article class=\"plan-card\" data-plan=\"free\" data-monthly=\"0\" data-yearly=\"0\" data-year-total=\"0\">\n      <h2 class=\"plan-name\">Free</h2>\n      <p class=\"plan-who\">For teams getting started at no cost.</p>\n      <p class=\"plan-price\"><span class=\"plan-amount\">$0</span><span class=\"plan-unit\">per seat, forever</span></p><p class=\"plan-detail\">Free on monthly or yearly billing</p>\n      <ul class=\"plan-points\"><li>Unlimited members</li><li>Unlimited open tickets</li><li>Own up to 3 boards (archived boards do not count)</li><li>Small starter AI allowance</li></ul>\n      <a class=\"plan-cta\" href=\"https://app.hypertask.ai/login\">Start free</a>\n    </article><article class=\"plan-card\" data-plan=\"byok\" data-monthly=\"10\" data-yearly=\"8\" data-year-total=\"96\">\n      <h2 class=\"plan-name\">BYOK</h2>\n      <p class=\"plan-who\">For teams that bring their own AI keys.</p>\n      <p class=\"plan-price\"><span class=\"plan-amount price-yearly\">$8</span><span class=\"plan-amount price-monthly\">$10</span><span class=\"plan-unit\">per seat / month</span></p>\n        <p class=\"plan-detail price-yearly\">$96 per seat, billed yearly</p>\n        <p class=\"plan-detail price-monthly\">Billed every month</p>\n        <p class=\"plan-alt price-yearly\">or $10/seat/month billed monthly</p>\n        <p class=\"plan-alt price-monthly\">or $8/seat/month billed yearly ($96/yr)</p>\n      <ul class=\"plan-points\"><li>Use your own AI keys</li><li>Email support</li><li>14-day trial</li></ul>\n      <a class=\"plan-cta\" href=\"https://app.hypertask.ai/login\">Start 14-day trial</a>\n    </article><article class=\"plan-card\" data-plan=\"pro\" data-monthly=\"20\" data-yearly=\"16\" data-year-total=\"192\">\n      <h2 class=\"plan-name\">Pro</h2>\n      <p class=\"plan-who\">For teams that want managed AI, with no keys.</p>\n      <p class=\"plan-price\"><span class=\"plan-amount price-yearly\">$16</span><span class=\"plan-amount price-monthly\">$20</span><span class=\"plan-unit\">per seat / month</span></p>\n        <p class=\"plan-detail price-yearly\">$192 per seat, billed yearly</p>\n        <p class=\"plan-detail price-monthly\">Billed every month</p>\n        <p class=\"plan-alt price-yearly\">or $20/seat/month billed monthly</p>\n        <p class=\"plan-alt price-monthly\">or $16/seat/month billed yearly ($192/yr)</p>\n      <ul class=\"plan-points\"><li>Managed AI models, no keys to manage</li><li>Integrations</li><li>Priority support</li><li>14-day trial</li></ul>\n      <a class=\"plan-cta\" href=\"https://app.hypertask.ai/login\">Start 14-day trial</a>\n    </article></div>\n    <p class=\"plan-note\">Paid plans include a 14-day trial and are offered for up to 50 seats. For more than 50 seats, email <a href=\"mailto:help@hypertask.ai\">help@hypertask.ai</a>.</p>\n  </section>\n      <p class=\"article-excerpt\">Free is $0 forever, with unlimited members, unlimited open tickets and up to 3 owned boards. Paid plans per user per month: BYOK $10 monthly or $8 billed yearly, Pro $20 monthly or $16 billed yearly. Paid plans come with a 14-day trial. Upgrade in Settings > Plans.</p>\n    </header>\n\n    <div class=\"content\">\n      <p>Hypertask has three plans: <strong>Free</strong>, <strong>BYOK</strong> and <strong>Pro</strong>. The current price list is always on the pricing page: <a href=\"https://hypertask.ai/pricing\" target=\"_blank\" rel=\"noopener noreferrer\">https://hypertask.ai/pricing</a></p>\n<h2>Is Hypertask free?</h2>\n<p>Yes. The Free plan costs $0 and is free forever. You can use it with your whole team.</p>\n<h2>Is there a free trial?</h2>\n<p>Yes. Paid plans come with a 14-day trial (also asked as &quot;free trial&quot;, &quot;trial period&quot;, &quot;how long is the trial&quot; or misspelled &quot;trail&quot;). The Free plan itself is free forever, with no trial needed.</p>\n<h2>How many people are included in a free team?</h2>\n<p>There is no member limit on the Free plan. A free team can have unlimited members, so you can invite as many people (users) as you need.</p>\n<h2>How many boards and tickets can I have on Free? (board and ticket limits)</h2>\n<p>On the Free plan you get unlimited members and unlimited open tickets. You can own up to 3 boards. Archived boards are not counted. A paid or trialing plan has no board limit.</p>\n<h2>What are the limitations of the Free plan?</h2>\n<p>Free plan limits (also asked as &quot;freeplan&quot;, &quot;free tier&quot;, &quot;free version&quot; or &quot;free account&quot; limits, limitations or restrictions): A free team gets unlimited members and unlimited open tickets, and each person can own up to 3 boards (archived boards are not counted). It costs $0, is free forever, and needs no credit card. A paid or trialing plan has no board limit.</p>\n<p>What Free does not include, compared with paid plans:</p>\n<ul><li>More than 3 owned boards. Paid and trialing plans have no board limit.</li><li>Free includes a small starter AI allowance on fast budget models. For more AI, Pro includes more AI on Hypertask's managed models, or BYOK runs AI on your own keys.</li><li>Integrations come with Pro.</li><li>Support on Free is email support. Pro gets priority support.</li><li>File uploads: Free includes file uploads and storage. This article does not list file size or total storage limits, so don't promise a storage number or unlimited storage; point to <a href=\"https://hypertask.ai/pricing\" target=\"_blank\" rel=\"noopener noreferrer\">https://hypertask.ai/pricing</a> for current details.</li></ul>\n<h2>Do I need a credit card to start?</h2>\n<p>No. You don't need a credit card to start. Sign up with <strong>Start for free</strong> (<a href=\"https://app.hypertask.ai/login)\" target=\"_blank\" rel=\"noopener noreferrer\">https://app.hypertask.ai/login)</a> and choose a paid plan only when you are ready.</p>\n<h2>How much does Hypertask cost?</h2>\n<p>Paid plans are priced per user (per seat). You can pay yearly or monthly.</p>\n<p><strong>Billed yearly</strong></p>\n<ul><li>BYOK: $8 per user / month ($96 per user / year)</li><li>Pro: $16 per user / month ($192 per user / year)</li></ul>\n<p><strong>Billed monthly</strong></p>\n<ul><li>BYOK: $10 per user / month</li><li>Pro: $20 per user / month</li></ul>\n<p>Free is $0. Paying yearly saves 20%.</p>\n<h2>Seats on paid plans</h2>\n<p>BYOK and Pro are offered for teams of up to 50 seats, billed monthly or yearly. When someone joins a team on a paid plan, the number of seats on the subscription is updated.</p>\n<p>The pricing page lists only these monthly and yearly prices, for up to 50 seats. It does not list volume discounts, multi-year plans or paying by invoice, so we can't promise any of those here. To ask about more than 50 seats or other billing needs, email help@hypertask.ai or ask here to talk to a human on the team.</p>\n<h2>What each plan includes</h2>\n<p><strong>Free</strong></p>\n<ul><li>Unlimited members and unlimited open tickets</li><li>Own up to 3 boards (archived boards are not counted)</li><li>A small included starter AI allowance on fast budget models</li><li>CLI and MCP access for AI agents</li><li>Email support</li></ul>\n<p><strong>BYOK (bring your own key)</strong></p>\n<ul><li>All AI features, running on your own API keys from Anthropic, OpenAI or OpenRouter</li><li>Up to 50 team seats</li><li>CLI and MCP access</li><li>Email support</li></ul>\n<p><strong>Pro</strong> (for teams that want more AI, with no keys to manage, plus integrations)</p>\n<ul><li>Everything in BYOK</li><li>More AI included, on Hypertask's managed models, with no API keys to manage</li><li>Integrations</li><li>Priority support</li></ul>\n<h2>How much AI is included?</h2>\n<ul><li><strong>Free:</strong> a small included starter allowance of AI on fast budget models.</li><li><strong>Pro:</strong> more AI included, on Hypertask's managed models. No keys to manage.</li><li><strong>BYOK:</strong> AI runs on your own Anthropic, OpenAI or OpenRouter keys.</li></ul>\n<p>The app shows how much of this month's included AI your team has used: the team owner or a board admin can see it in <strong>Settings → AI Usage</strong>.</p>\n<h2>How to upgrade</h2>\n<p>In the Hypertask app, open <strong>Settings → Plans</strong> (<a href=\"https://app.hypertask.ai/settings/plans)\" target=\"_blank\" rel=\"noopener noreferrer\">https://app.hypertask.ai/settings/plans)</a>, choose BYOK or Pro, then pick monthly or yearly billing.</p>\n<h2>Questions about price or billing</h2>\n<p>See <a href=\"https://hypertask.ai/pricing\" target=\"_blank\" rel=\"noopener noreferrer\">https://hypertask.ai/pricing</a>, email help@hypertask.ai, or ask here to talk to a human on the team.</p>\n    </div>\n\n    <footer class=\"article-footer\">\n      <p class=\"article-footer-text\">Was this article helpful?</p>\n      <div class=\"feedback-buttons\">\n        <button class=\"feedback-btn\" onclick=\"this.innerHTML='Thanks for the feedback!'\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M7 10v12\"></path>\n            <path d=\"M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2h0a3.13 3.13 0 0 1 3 3.88Z\"></path>\n          </svg>\n          Yes\n        </button>\n        <button class=\"feedback-btn\" onclick=\"this.innerHTML='Thanks for the feedback!'\">\n          <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <path d=\"M17 14V2\"></path>\n            <path d=\"M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22h0a3.13 3.13 0 0 1-3-3.88Z\"></path>\n          </svg>\n          No\n        </button>\n      </div>\n    </footer>\n\n    \n    <div class=\"related-articles\">\n      <h3 class=\"related-title\">Related Articles</h3>\n      \n        <a href=\"/help/how-to-create-tasks-in-hypertasks\" class=\"related-link\">How to Create Tasks in Hypertask</a>\n      \n        <a href=\"/help/how-to-create-a-kanban-board-in-hypertasks\" class=\"related-link\">How to Create a Kanban Board in Hypertask</a>\n      \n        <a href=\"/help/how-to-receive-notifications-from-hypertasks\" class=\"related-link\">How to Receive Notifications from Hypertask</a>\n      \n        <a href=\"/help/bulk-actions-archive-and-defer-multiple-tasks-at-once-in-hypertask\" class=\"related-link\">Bulk Actions: Archive and Defer Multiple Tasks at Once in Hypertask</a>\n      \n        <a href=\"/help/creating-tasks-from-comments-in-hypertasks\" class=\"related-link\">Creating Tasks from Comments in Hypertask</a>\n      \n    </div>\n  \n  </article>\n\n  <script src=\"/widget/widget.js\"></script>\n  <script>\n    (function() {\n      var header = document.querySelector('.site-header');\n      if (!header) return;\n      window.addEventListener('scroll', function() {\n        if (window.scrollY > 0) {\n          header.classList.add('scrolled');\n        } else {\n          header.classList.remove('scrolled');\n        }\n      });\n    })();\n  </script>\n</body>\n</html>"
}
